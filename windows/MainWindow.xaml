<Window x:Class="DroidBox.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="DroidBox" Width="1180" Height="790" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#090B14" Foreground="#F5F6FF" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" Opacity="0">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="Glass" Color="#B51B2235"/>
  <DropShadowEffect x:Key="SoftShadow" BlurRadius="28" ShadowDepth="8" Opacity=".24" Color="#000000"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F8F8FF"/><Setter Property="Background" Value="#735BFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#8D7DFF"/><Setter Property="Padding" Value="16,11"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value=".84"/><Setter TargetName="bd" Property="BorderBrush" Value="#C6BDFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value=".38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#302D4158"/><Setter Property="BorderBrush" Value="#3EFFFFFF"/><Setter Property="Foreground" Value="#E6E9F7"/></Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#AFA5FF"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.Background><RadialGradientBrush GradientOrigin="0.12,0.08" Center="0.12,0.08" RadiusX="1.1" RadiusY="1.1"><GradientStop Color="#25204C" Offset="0"/><GradientStop Color="#101629" Offset=".48"/><GradientStop Color="#090B14" Offset="1"/></RadialGradientBrush></Grid.Background>
  <Grid Height="46" VerticalAlignment="Top" Background="#D90C1222" Panel.ZIndex="20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Border Width="25" Height="25" CornerRadius="8" Background="#665C4CFF" BorderBrush="#A88DFF" BorderThickness="1"><TextBlock Text="N" FontSize="16" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Black"/></Border>
    <TextBlock Text="DroidBox" FontSize="12" FontWeight="SemiBold" Foreground="#E9ECFA" Margin="9,0,0,0" VerticalAlignment="Center"/>
    <TextBlock Text="  ·  NKK" FontSize="10" Foreground="#8994AE" Margin="4,0,0,0" VerticalAlignment="Center"/>
   </StackPanel>
   <Button Grid.Column="1" Content="—" Click="MinimizeWindow_Click" Background="Transparent" BorderThickness="0" Padding="0" FontSize="16" FontWeight="Normal" Foreground="#C7CEE2" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   <Button Grid.Column="2" Content="□" Click="MaximizeWindow_Click" Background="Transparent" BorderThickness="0" Padding="0" FontSize="14" FontWeight="Normal" Foreground="#C7CEE2" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   <Button Grid.Column="3" Content="×" Click="CloseWindow_Click" Background="Transparent" BorderThickness="0" Padding="0" FontSize="19" FontWeight="Normal" Foreground="#C7CEE2" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
  </Grid>
  
  <Ellipse Width="430" Height="430" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-210,-130,0" Fill="#267A5BFF" IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
  <Ellipse Width="330" Height="330" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-160,0,0,-170" Fill="#1B20B9D6" IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect></Ellipse>
  <Grid Margin="30,68,30,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="48" Height="48" CornerRadius="15" Background="#665C4CFF" BorderBrush="#A88DFF" BorderThickness="1"><Grid><TextBlock Text="N" FontSize="29" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Black"/><Ellipse Width="7" Height="7" Fill="#66F4D6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"/></Grid></Border>
     <StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="DroidBox" FontSize="23" FontWeight="Bold"/><TextBlock Text="ANDROID, MEET WINDOWS." FontSize="9" Foreground="#9DA8C5" FontWeight="Bold" Margin="1,2,0,0"/></StackPanel>
     <Border Background="#2331D5A5" BorderBrush="#5543D8B0" BorderThickness="1" CornerRadius="20" Padding="10,5" Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock Text="PREVIEW" Foreground="#83E9C9" FontSize="9" FontWeight="Bold"/></Border>
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="255"><Button Content="↻   Check for updates" Click="CheckForUpdatesButton_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="14,8"/><TextBlock x:Name="UpdateStatusText" Text="Checking for updates when DroidBox starts…" Foreground="#8994AE" FontSize="10" TextAlignment="Right" TextWrapping="Wrap" Margin="0,7,2,0"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="2,0,0,22"><StackPanel><TextBlock Text="Your Android workspace." FontSize="30" FontWeight="Bold" Foreground="#F5F4FF"/><TextBlock Text="Add your Android apps, keep them in one place and explore what runs on Windows." FontSize="13" Foreground="#A9B2C9" Margin="0,7,0,0"/></StackPanel></Grid>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Glass}" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="24" Padding="25" Effect="{StaticResource SoftShadow}">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><StackPanel><TextBlock Text="01  /  APK LIBRARY" Style="{StaticResource Eyebrow}"/><TextBlock Text="Bring an app in" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="#2CFFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="18" Padding="9,5"><TextBlock Text="APK  •  ANDROID" FontSize="9" Foreground="#C9C3FF" FontWeight="Bold"/></Border></Grid>
      <Border Grid.Row="1" Margin="0,20,0,18" Background="#252B4050" BorderBrush="#50A99BFF" BorderThickness="1" CornerRadius="20"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="390">
       <Border Width="76" Height="76" CornerRadius="23" Background="#665B4AFF" BorderBrush="#8F8A7BFF" BorderThickness="1" HorizontalAlignment="Center"><Grid><TextBlock Text="↓" FontSize="38" Foreground="#E8E3FF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="8" Height="8" Fill="#70F0D1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,13,0"/></Grid></Border>
       <TextBlock Text="Drop your APK here" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,17,0,0"/><TextBlock Text="or choose a file from your computer" Foreground="#A8B3CD" FontSize="12" HorizontalAlignment="Center" Margin="0,7,0,0"/>
       <Button x:Name="SelectButton" Content="＋  Add app" Click="SelectButton_Click" Width="170" Margin="0,20,0,0"/><TextBlock Text="Your APK stays on your device. Inspection does not run its code." Foreground="#8D9AB6" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"/>
      </StackPanel></Border>
      <Border Grid.Row="2" Background="#A6242D43" BorderBrush="#4CFFFFFF" BorderThickness="1" CornerRadius="16" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="MY APPS · STORED ON THIS PC" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button Content="Remove" Click="RemoveAppButton_Click" Style="{StaticResource QuietButton}" Padding="10,5" HorizontalAlignment="Right"/></Grid><TextBox x:Name="AppSearchBox" Grid.Row="1" Margin="0,9,0,0" Height="32" Padding="10,5" Background="#182238" Foreground="#F5F6FF" BorderBrush="#35415C" TextChanged="AppSearchBox_TextChanged" ToolTip="Search apps by name or package ID" VerticalContentAlignment="Center"/><ListBox x:Name="AppLibraryList" Grid.Row="2" Margin="0,8,0,9" Background="#182238" Foreground="#F5F6FF" BorderBrush="#35415C" BorderThickness="1" SelectionChanged="AppLibraryList_SelectionChanged" MouseDoubleClick="AppLibraryList_MouseDoubleClick" ToolTip="Select an app to view details. Double-click it to launch." ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border Background="#2530445E" BorderBrush="#284E5B7A" BorderThickness="1" CornerRadius="10" Padding="8" Margin="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="9" Background="#3446B99A" BorderBrush="#665CE0C1" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="A" FontSize="17" FontWeight="Bold" Foreground="#8CEBD1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PackageSummary}" Foreground="#A8B3CD" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="3"><TextBlock x:Name="FileInfoText" Foreground="#A8B3CD" FontSize="10"/><TextBlock x:Name="InspectStatus" Foreground="#AFA5FF" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock x:Name="MetadataText" Foreground="#D6DCEC" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border>
     </Grid>
    </Border>
    <StackPanel Grid.Column="2">
     <Border Background="{StaticResource Glass}" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="22" Padding="21" Effect="{StaticResource SoftShadow}"><StackPanel>
      <TextBlock Text="02  /  RUNTIME" Style="{StaticResource Eyebrow}"/><TextBlock Text="Runtime status" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="The Android engine is managed by DroidBox. You do not need to select an executable." Foreground="#A8B3CD" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <Border Background="#2635D6B2" BorderBrush="#5543D8B0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,16,0,0"><TextBlock Text="Managed by DroidBox · Windows x64" Foreground="#A9EAD8" FontSize="11" TextWrapping="Wrap"/></Border>
      <TextBlock x:Name="RuntimePathText" Text="No runtime selected" Foreground="#AFA5FF" FontSize="10" TextWrapping="Wrap" Margin="1,10,0,0"/><Button Content="Run runtime diagnostics" Click="CheckRuntimeButton_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Margin="0,13,0,0"/><TextBlock x:Name="RuntimeDiagnosticsText" Text="Diagnostics have not been run." Foreground="#A8B3CD" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <Button x:Name="RunAppButton" Content="Launch selected APK  →" Click="RunAppButton_Click" IsEnabled="False" Margin="0,15,0,0"/><Button x:Name="StopRuntimeButton" Content="Stop running app" Click="StopRuntimeButton_Click" IsEnabled="False" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/>
     </StackPanel></Border>
     <Border Background="#8F362D27" BorderBrush="#55E8B77C" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,15,0,0"><StackPanel><TextBlock Text="EXPERIMENTAL RUNTIME" FontSize="9" FontWeight="Bold" Foreground="#F0C18D"/><TextBlock Text="APK execution is not sandboxed yet. Only test APKs you trust." FontSize="11" Foreground="#D9C6B4" TextWrapping="Wrap" Margin="0,7,0,0"/><Button Content="Diagnostics &amp; send report" Click="OpenRuntimeLogsButton_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="12,7" Margin="0,10,0,0"/></StackPanel></Border>
     <Border Background="#76252B42" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,15,0,0"><StackPanel><TextBlock Text="NEED A TEST APP?" FontSize="9" FontWeight="Bold" Foreground="#AFA5FF"/><TextBlock Text="Try the DroidBox smoke-test APK built by GitHub Actions." FontSize="11" Foreground="#A8B3CD" TextWrapping="Wrap" Margin="0,7,0,0"/><Button Content="Get test APK ↗" Click="DownloadTestApkButton_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="12,7" Margin="0,10,0,0"/></StackPanel></Border>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="3" Margin="2,18,2,0"><TextBlock Text="NKK  /  DROIDBOX" Foreground="#707D99" FontSize="9" FontWeight="Bold"/><TextBlock Text="Built for Windows 11  •  Made by N. Krishna Karthik" Foreground="#707D99" FontSize="10" HorizontalAlignment="Right"/></Grid>
  </Grid>
 </Grid>
</Window>