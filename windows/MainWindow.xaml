<Window x:Class="DroidBox.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DroidBox" Width="1080" Height="720" MinWidth="820" MinHeight="600" Background="#111116" Foreground="#F4F4F7" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel><TextBlock Text="DroidBox" FontSize="28" FontWeight="Bold"/><TextBlock Text="Android apps. Windows freedom." Foreground="#A4A4B3" Margin="0,3,0,0"/></StackPanel>
      <Border HorizontalAlignment="Right" Background="#252530" CornerRadius="16" Padding="12,7"><TextBlock Text="PREVIEW BUILD  •  EXPERIMENTAL RUNTIME BRIDGE" FontSize="11" Foreground="#B9ACFF" FontWeight="SemiBold"/></Border>
    </Grid>
    <Grid Grid.Row="1" Margin="0,28,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#1C1C24" CornerRadius="22" Padding="28">
        <Grid>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
            <Border Width="84" Height="84" CornerRadius="24" Background="#30294C" HorizontalAlignment="Center"><TextBlock Text="APK" FontSize="24" FontWeight="Bold" Foreground="#B9ACFF" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            <TextBlock Text="Bring an Android app" FontSize="26" FontWeight="Bold" Margin="0,22,0,0" HorizontalAlignment="Center"/>
            <TextBlock Text="Select an APK to see its package details and compatibility information." TextWrapping="Wrap" Foreground="#A4A4B3" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
            <Button x:Name="SelectButton" Content="Select APK" Margin="0,24,0,0" Click="SelectButton_Click" Width="160"/>
            <TextBlock Text="or drop an APK anywhere in this window" Foreground="#777783" FontSize="12" Margin="0,12,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border x:Name="SelectedPanel" Visibility="Collapsed" Background="#252530" CornerRadius="16" Padding="20" VerticalAlignment="Bottom">
            <StackPanel><TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="FileInfoText" Foreground="#A4A4B3" Margin="0,6,0,0"/><TextBlock x:Name="InspectStatus" Foreground="#B9ACFF" Margin="0,12,0,0"/><TextBlock x:Name="MetadataText" Foreground="#D3D3DD" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"/></StackPanel>
          </Border>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="#1C1C24" CornerRadius="22" Padding="22">
        <StackPanel>
          <TextBlock Text="Runtime" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="Experimental external engine" Foreground="#A4A4B3" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <Button Content="Select Stubuika / Lunaria" Click="SelectRuntimeButton_Click" Margin="0,14,0,0"/>
          <TextBlock x:Name="RuntimePathText" Text="No runtime selected" Foreground="#777783" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <Button x:Name="RunAppButton" Content="Run selected APK" Click="RunAppButton_Click" IsEnabled="False" Margin="0,20,0,0" Background="#37343F"/>
          <TextBlock Text="Launches APK in the external runtime. DroidBox does not yet isolate APK code from your Windows account." Foreground="#D0A6A6" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
          <Separator Margin="0,20,0,16" Background="#383844"/>
          <TextBlock Text="INSPECTION" FontSize="11" Foreground="#777783" FontWeight="Bold"/>
          <TextBlock Text="Package &amp; version • SDK requirements • permissions • DEX and native ABI inventory" Foreground="#D3D3DD" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22"/>
        </StackPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="2"><TextBlock Text="Made with love by N. Krishna Karthik ♥" Foreground="#777783" FontSize="12"/><TextBlock Text="DroidBox by NKK" Foreground="#777783" FontSize="12" HorizontalAlignment="Right"/></Grid>
  </Grid>
</Window>
