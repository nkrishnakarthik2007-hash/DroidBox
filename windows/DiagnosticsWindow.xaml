<Window x:Class="DroidBox.Windows.DiagnosticsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NKK DroidBox · Diagnostics" Width="960" Height="690" MinWidth="720" MinHeight="500"
 WindowStartupLocation="CenterOwner" Background="#0B1020" Foreground="#F4F5FF">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F8F8FF"/><Setter Property="Background" Value="#735BFF"/><Setter Property="BorderBrush" Value="#8D7DFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,9"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value=".82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#273148"/><Setter Property="BorderBrush" Value="#46516D"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="NKK  /  DROIDBOX  /  DEVELOPER TOOLS" Foreground="#AFA5FF" FontSize="10" FontWeight="Bold"/>
   <TextBlock Text="Diagnostics &amp; activity" FontSize="27" FontWeight="Bold" Margin="0,7,0,0"/>
   <TextBlock Text="Runtime output, errors and Windows environment details — ready to share with the developer." Foreground="#A8B3CD" FontSize="12" Margin="0,5,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Margin="0,18,0,0" Background="#25213D" BorderBrush="#6256B9" BorderThickness="1" CornerRadius="14" Padding="14">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="SEND A DIAGNOSTIC REPORT" Foreground="#C8BFFF" FontSize="9" FontWeight="Bold"/>
     <TextBlock Text="Share recent logs directly with NKK on GitHub." Foreground="#F4F1FF" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
     <TextBlock Text="Only log text and basic Windows details are included. APK files are never uploaded. Reports create a PUBLIC GitHub issue." Foreground="#B9B4D4" FontSize="10" TextWrapping="Wrap" Margin="0,4,12,0"/>
    </StackPanel>
    <Button x:Name="SendReportButton" Grid.Column="1" Content="↑   Send report" Click="SendReport_Click" VerticalAlignment="Center" Padding="18,12"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="0,16,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="SearchBox" Grid.Column="0" Height="36" VerticalContentAlignment="Center" Padding="10,4" Background="#172238" Foreground="#F4F5FF" BorderBrush="#46516D" TextChanged="SearchBox_TextChanged" ToolTip="Search messages"/>
   <ComboBox x:Name="LevelFilter" Grid.Column="1" Margin="8,0,0,0" Height="36" SelectedIndex="0" SelectionChanged="LevelFilter_SelectionChanged" Background="#172238" Foreground="#F4F5FF">
    <ComboBoxItem Content="All messages"/><ComboBoxItem Content="Errors only"/><ComboBoxItem Content="Warnings"/><ComboBoxItem Content="DroidBox only"/>
   </ComboBox>
   <Button Grid.Column="2" Content="Refresh" Click="Refresh_Click" Margin="8,0,0,0" Padding="13,7" Style="{StaticResource QuietButton}"/>
   <Button Grid.Column="3" Content="Open folder" Click="OpenFolder_Click" Margin="8,0,0,0" Padding="13,7" Style="{StaticResource QuietButton}"/>
  </Grid>
  <Border Grid.Row="3" Background="#10192B" BorderBrush="#35415C" BorderThickness="1" CornerRadius="12" Padding="10">
   <TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="#D7DEEF" FontFamily="Cascadia Mono" FontSize="11"/>
  </Border>
  <Grid Grid.Row="4" Margin="0,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Grid.Column="0" Text="Looking for DroidBox logs…" Foreground="#8994AE" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Copy visible logs" Click="Copy_Click" Style="{StaticResource QuietButton}" Padding="13,7"/><Button Content="Close" Click="Close_Click" Padding="13,7" Margin="8,0,0,0" Style="{StaticResource QuietButton}"/></StackPanel>
  </Grid>
 </Grid>
</Window>
