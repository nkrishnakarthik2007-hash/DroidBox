<Window x:Class="DroidBox.Windows.DiagnosticsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DroidBox Diagnostics" Width="900" Height="620" MinWidth="650" MinHeight="420"
 WindowStartupLocation="CenterOwner" Background="#0B1020" Foreground="#F4F5FF">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="NKK  /  DROIDBOX" Foreground="#AFA5FF" FontSize="10" FontWeight="Bold"/>
   <TextBlock Text="Diagnostics &amp; activity" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/>
   <TextBlock Text="A readable view of what DroidBox and its experimental runtime reported." Foreground="#A8B3CD" FontSize="12" Margin="0,5,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,18,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="SearchBox" Grid.Column="0" Height="36" VerticalContentAlignment="Center" Padding="10,4" Background="#172238" Foreground="#F4F5FF" BorderBrush="#46516D" TextChanged="SearchBox_TextChanged" ToolTip="Search messages"/>
   <ComboBox x:Name="LevelFilter" Grid.Column="1" Margin="8,0,0,0" Height="36" SelectedIndex="0" SelectionChanged="LevelFilter_SelectionChanged" Background="#172238" Foreground="#F4F5FF">
    <ComboBoxItem Content="All messages"/><ComboBoxItem Content="Errors only"/><ComboBoxItem Content="Warnings"/><ComboBoxItem Content="DroidBox only"/>
   </ComboBox>
   <Button Grid.Column="2" Content="Refresh" Click="Refresh_Click" Margin="8,0,0,0" Padding="13,7"/>
   <Button Grid.Column="3" Content="Open folder" Click="OpenFolder_Click" Margin="8,0,0,0" Padding="13,7" Background="#30384F" BorderBrush="#53617D"/>
  </Grid>
  <Border Grid.Row="2" Background="#10192B" BorderBrush="#35415C" BorderThickness="1" CornerRadius="12" Padding="10">
   <TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="#D7DEEF" FontFamily="Cascadia Mono" FontSize="11" />
  </Border>
  <Grid Grid.Row="3" Margin="0,12,0,0">
   <TextBlock x:Name="StatusText" Text="Looking for DroidBox logs…" Foreground="#8994AE" FontSize="10" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Copy visible logs" Click="Copy_Click" Padding="13,7"/><Button Content="Close" Click="Close_Click" Padding="13,7" Margin="8,0,0,0" Background="#30384F" BorderBrush="#53617D"/></StackPanel>
  </Grid>
 </Grid>
</Window>