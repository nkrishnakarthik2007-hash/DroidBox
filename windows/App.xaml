<Application x:Class="DroidBox.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#7C5CFC"/>
    <SolidColorBrush x:Key="Surface" Color="#1C1C24"/>
    <SolidColorBrush x:Key="Surface2" Color="#252530"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F7"/>
    <SolidColorBrush x:Key="TextMuted" Color="#A4A4B3"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,10"/><Setter Property="Background" Value="#7C5CFC"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Application.Resources>
</Application>
